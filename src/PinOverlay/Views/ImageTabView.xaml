<UserControl x:Class="PinOverlay.Views.ImageTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PinOverlay.ViewModels">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="12,10,12,6" VerticalAlignment="Center">
            <TextBlock Text="拡大率" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Width="56" VerticalContentAlignment="Center"
                     Text="{Binding ScaleText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,20,0" />

            <TextBlock Text="最大サイズ" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="80" IsEditable="True"
                      ItemsSource="{Binding MaxSizePresets}"
                      Text="{Binding MaxSizeText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="px" VerticalAlignment="Center" Margin="4,0,20,0" />

            <TextBlock Text="折り返し幅" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Width="56" VerticalContentAlignment="Center"
                     Text="{Binding WrapWidthText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="px" VerticalAlignment="Center" Margin="4,0,20,0" />

            <Button Content="すべて表示" Padding="10,2" Margin="0,0,6,0" Click="OnCheckAll" />
            <Button Content="すべて非表示" Padding="10,2" Click="OnUncheckAll" />
        </WrapPanel>

        <TextBlock DockPanel.Dock="Top" Margin="12,0,12,6" Foreground="#666" FontSize="11"
                   Text="拡大率をかけたあと、長いほうの辺が最大サイズを超える場合は縦横比を保ったまま縮小します。並べた画像が折り返し幅を超えると次の行に送ります（0 で折り返さない）。" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}" Margin="8,0,8,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ImageItemViewModel}">
                        <Border x:Name="Card" Width="128" Margin="4" Padding="6" CornerRadius="6"
                                Background="White" BorderBrush="#DDD" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonUp="OnCardClick">
                            <StackPanel>
                                <Grid Height="88" Margin="0,0,0,6">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock x:Name="Broken" Text="読み込めません" Foreground="#C00" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                                <CheckBox IsChecked="{Binding IsChecked}">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FileName}" />
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#0067C0" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                <Setter TargetName="Broken" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
